# Copy this file to .env (in the HW4 folder) and fill in your own values.
# Never commit or share the real .env.

# Portkey API key (required for the chatbot)
PORTKEY_API_KEY=your-portkey-api-key-here

# Model settings (optional; these are the defaults used by backend/agent.py)
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_MODEL=gpt-6-astra

# Optional: key used to sign login cookies. If unset, backend/auth.py creates
# a random one in backend/.session_secret (git-ignored).
# SESSION_SECRET=change-me
